# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/depot_pos

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS (comma separated origins, or * )
CORS_ORIGIN=*

# Mail (Gmail: SMTP_USER = full Gmail address, SMTP_PASS = 16-char App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=http://localhost:4000

# Bootstrap admin (used by `npm run seed`)
ADMIN_NAME=Shop Admin
ADMIN_EMAIL=admin@depot.local
ADMIN_PASSWORD=change-me
